# ---------------------------------------------------------------------------
# DocuAssist PH — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by the public tracking RPC caller and the create-staff
# script. NEVER expose this to the browser / prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site (required) -------------------------------------------------------
# Public base URL, used to build /track/{code} links and QR codes.
# In local dev use http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Semaphore SMS (optional) ----------------------------------------------
# If SEMAPHORE_API_KEY is blank, SMS is STUBBED: sends are logged to the
# console + notifications_log instead of being sent. Add the real key later.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=DocuAssist

# --- Anthropic (optional) --------------------------------------------------
# Powers the Tier-2 "Paste & Parse" fallback. If ANTHROPIC_API_KEY is blank,
# Tier-2 is skipped and only the free rule-based Tier-1 parser runs.
ANTHROPIC_API_KEY=
ANTHROPIC_PARSE_MODEL=claude-haiku-4-5
